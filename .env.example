# ─── Browser settings (VITE_ prefix = baked into the public app) ───────────
# Firebase web app config: Firebase console → Project settings → Your apps → Web.
# These identify the project and are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Sign-in methods: email (free, code by email), google (free), phone (SMS, paid).
VITE_AUTH_METHODS=email,google

# true only for local development against the Firebase emulators.
VITE_FIREBASE_USE_EMULATORS=false

# ─── Server secrets (NO VITE_ prefix — never sent to browsers) ─────────────
# Set these in Vercel → Settings → Environment Variables. Never commit them.

# Firebase service account: Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value; keep the \n sequences as they are.
FIREBASE_PRIVATE_KEY=

# Random string of 32+ characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Any SMTP service. Free options: Gmail with an app password (smtp.gmail.com, 587),
# or Brevo (smtp-relay.brevo.com, 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CodeCompass <you@example.com>"
APP_NAME=CodeCompass
