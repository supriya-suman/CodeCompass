{
  "name": "codecompass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-codecompass \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-codecompass",
    "dev:emulator": "vite --mode emulator",
    "dev:api": "tsx scripts/dev-api.ts",
    "dev:api:emulator": "tsx scripts/dev-api.ts .env.emulator"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "nodemailer": "^10.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^28.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "firebase-tools": "^15.34.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
