rules_version = '2';

// CodeCompass security rules.
// Each person can read and write ONLY users/{their own uid}/records/*.
// Everything else in the database is denied. Phone numbers are never stored
// in Firestore; identity comes from Firebase Auth.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validRecord(docId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['table', 'id', 'data', 'updatedAt', 'deleted', 'serverUpdatedAt'])
        && d.keys().hasAll(['table', 'id', 'data', 'updatedAt', 'deleted', 'serverUpdatedAt'])
        && d.table in ['questions', 'timeEntries', 'activeTimer', 'goals', 'tasks', 'assessments', 'profiles', 'settings', 'appUsage']
        && d.id is string && d.id.size() > 0 && d.id.size() <= 100
        && docId == d.table + '__' + d.id
        && d.updatedAt is string && d.updatedAt.size() <= 40
        && d.deleted is bool
        && (d.deleted ? d.data == null : d.data is map)
        && d.serverUpdatedAt == request.time;
    }

    match /users/{uid}/records/{docId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validRecord(docId);
      allow delete: if signedInAs(uid);
    }

    // Everything else is closed to browsers, including the sign-in code
    // records (otpChallenges, otpIps) that only the server's Admin SDK uses.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
